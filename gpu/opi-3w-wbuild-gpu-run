#!/bin/bash
# Run one command with the isolated PowerVR runtime. No background workload.
set -uo pipefail
if (( EUID != 0 )); then echo 'Run sudo opi-3w-wbuild-gpu-run COMMAND [ARGS...]' >&2; exit 1; fi
ROOT=/opt/opi-3w-wbuild-powervr
[[ -f $ROOT/manifest.json ]] || { echo 'PowerVR runtime not installed.' >&2; exit 1; }
ABI=$(python3 -c 'import json;print(json.load(open("/opt/opi-3w-wbuild-powervr/manifest.json"))["kernel_abi"])')
[[ $(uname -r) == "$ABI" ]] || { echo 'Running kernel differs from the PowerVR build.' >&2; exit 1; }
modprobe pvrsrvkm || exit 1
python3 - <<'PYCODE' || exit 1
from pathlib import Path
import sys
sys.path.insert(0,'/usr/local/lib/opi-3w-wbuild')
from pvr_version import canonical_ddk, EXPECTED_DDK
p=Path('/sys/module/pvrsrvkm/parameters/opi_3w_wbuild_ddk')
if not p.exists():p=Path('/sys/module/pvrsrvkm/version')
try:raw=p.read_text().strip()
except OSError as error:raise SystemExit('Cannot read loaded PowerVR DDK: '+str(error))
if canonical_ddk(raw)!=EXPECTED_DDK:raise SystemExit('Loaded PowerVR DDK mismatch: '+repr(raw))
PYCODE
export LD_LIBRARY_PATH="$ROOT/lib"
export OCL_ICD_VENDORS="$ROOT/OpenCL"
export VK_DRIVER_FILES="$ROOT/img_icd.json"
export VK_ICD_FILENAMES="$ROOT/img_icd.json"
unset RUSTICL_ENABLE VK_INSTANCE_LAYERS VK_LAYER_PATH VK_ADD_DRIVER_FILES
if (( $# == 0 )); then echo 'Usage: opi-3w-wbuild-gpu-run COMMAND [ARGS...]' >&2; exit 2; fi
exec "$@"
